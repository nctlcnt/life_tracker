# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
ALLOWED_USER_ID=your_discord_user_id

# ── AI provider ───────────────────────────────────────────────────────────────
# Provider: claude | relay | gemini
AI_PROVIDER=claude
AI_API_KEY=your_api_key_here

# Model names (match the provider above)
CHAT_MODEL=claude-opus-4-6
POLL_MODEL=claude-3-5-sonnet-latest

# Only needed when AI_PROVIDER=relay
# AI_BASE_URL=https://your-relay-endpoint.com

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=8080

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FILE=          # leave blank to log to stdout only (Docker-friendly)
